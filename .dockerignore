# The build context is the repository root, so keep the heavy, regenerable and
# host-specific directories out of it.
target/
demo/target/
.git/
bench-*/
artifacts/
signers/
.claude/
.agents/
tools/__pycache__/

# Prose is not compiled, and shipping it into the context means every edit to a
# README invalidates the layer that took four minutes to build.
*.md
